# Copy to .env in the repository root. Local development only.
APP_ENV=development
POSTGRES_USER=intervai
POSTGRES_PASSWORD=intervai_local_only
POSTGRES_DB=intervai
POSTGRES_PORT=5433
API_PORT=8000
FRONTEND_PORT=3000
DATABASE_URL=postgresql+psycopg://intervai:intervai_local_only@127.0.0.1:5433/intervai
API_INTERNAL_URL=http://127.0.0.1:8000
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
STORAGE_ROOT=./storage

# Run python scripts/init_environment.py to populate AUTH_SECRET locally.
AUTH_SECRET=
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false
AUTH_RATE_LIMIT_ATTEMPTS=10
AUTH_RATE_LIMIT_IP_ATTEMPTS=100
AUTH_RATE_LIMIT_WINDOW_SECONDS=900

# OpenAI is primary; Gemini uses GEMINI_API_KEY and GEMINI_MODEL as an alternative.
# GEMINI_MODEL / OPENAI_MODEL take precedence over the optional LLM_MODEL alias.
LLM_PROVIDER=openai
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=
OPENAI_MODEL=
LLM_MODEL=gpt-6-luna
LLM_API_KEY=
OPENAI_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=45
EMBEDDING_PROVIDER=
# Choose openai (OPENAI_API_KEY) or gemini (GEMINI_API_KEY).
# Gemini: EMBEDDING_PROVIDER=gemini, EMBEDDING_MODEL=gemini-embedding-2.
# The current pgvector schema requires EMBEDDING_DIMENSIONS=1536 for either provider.
# Camera is optional and starts only after explicit enable + browser permission.
VISION_ENABLED=false
VISION_SAMPLE_INTERVAL_MS=1000
VISION_DETECTION_THRESHOLD=0.55
VISION_ABSENCE_MS=3000
VISION_CONFIRMATION_MS=2000
EMBEDDING_MODEL=
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=64
RETRIEVAL_TOP_K=6
RETRIEVAL_MIN_SIMILARITY=0.2
# Phase 7 learning generation and retry evaluation reuse the LLM/embedding
# settings above. Configure real secrets locally at final integration.
# Without providers, persisted roadmaps and source-excerpt reading still work;
# AI content generation and answer grading remain explicitly unavailable.
STT_PROVIDER=vosk
STT_API_KEY=
STT_MODEL=
TTS_PROVIDER=espeak
TTS_API_KEY=
TTS_MODEL=
TTS_VOICE=en
STORAGE_PROVIDER=local
STORAGE_BUCKET=
STORAGE_ENDPOINT=
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
# Docker private execution network; no runner port is published to the host.
CODE_RUNNER_URL=http://sandbox:8080
# Configure a shared key of at least 32 characters at final production integration.
# It is passed only to the API/worker/runner and stripped from candidate environments.
CODE_RUNNER_API_KEY=
MEDIA_RETENTION_DAYS=7

# Local Vosk requires a separately installed language model; never auto-downloaded.
# Native: absolute model directory. Docker: /app/storage/models/vosk in shared volume.
VOSK_MODEL_PATH=
ESPEAK_EXECUTABLE=espeak-ng
TTS_SPEED=1
SPEECH_LANGUAGE=en
SPEECH_TIMEOUT_SECONDS=60
VOICE_MAX_SECONDS=180
VOICE_MIN_SPEECH_SECONDS=0.4
VOICE_SILENCE_SECONDS=3
VOICE_AUDIO_TTL_SECONDS=600
SPEECH_FILLERS=["um","uh","you know"]

# Natural cloud speech (optional): uses GEMINI_API_KEY or per-provider keys.
# STT_PROVIDER=gemini
# STT_MODEL=gemini-3.5-transcribe
# TTS_PROVIDER=gemini
# TTS_MODEL=gemini-3.8-flash-tts
# TTS_VOICE=Sulafat
# Voice recordings are sent to Google when Gemini transcription is enabled.
SPEECH_LOCALE=en-IN
